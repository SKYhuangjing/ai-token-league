{
  "name": "magpie-atl-sync",
  "version": "0.2.3",
  "description": "在 magpie 窗口里加一个「AI Token League」用量页：把 magpie 看得见的全部用量（网关账本 + 全部本地 agent 会话，request id 去重）签名同步到 AI Token League 榜单。A usage page in magpie's window: syncs everything magpie sees — gateway ledger plus all local agent sessions, request-id deduped — to an AI Token League board with Ed25519-signed hourly buckets.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SKYhuangjing/ai-token-league.git",
    "directory": "magpie-plugin"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie-plugin"
  ],
  "scripts": {
    "test": "bun test",
    "sync": "bun run sync.js"
  },
  "magpie": {
    "name": "AI Token League",
    "icon": "data:image/png;base64,",
    "hooks": "./hooks.js",
    "page": {
      "title": "AI Token League",
      "file": "page/index.html",
      "icon": "page/icon.svg",
      "titles": {
        "zh": "AI Token League"
      }
    },
    "permissions": [
      "usage:summary"
    ]
  },
  "files": [
    "lib",
    "page/index.html",
    "page/app.js",
    "page/view.js",
    "page/style.css",
    "page/icon.svg",
    "hooks.js",
    "sync.js",
    "index.js",
    "README.md",
    "LICENSE"
  ]
}