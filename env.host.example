# ============================================================
# 一、服务端配置
# 本地部署环境样例：使用 MySQL、自托管静态更新源，并启用匿名公开榜。
# ============================================================

# 1.0 服务端容器构建 / 依赖安装
NODE_IMAGE=docker.m.daocloud.io/library/node:22-bookworm-slim
NPM_REGISTRY=https://registry.npmmirror.com

# 1.1 服务端基础运行
HOST=0.0.0.0
PORT=8787
TZ=Asia/Shanghai

# 1.2 服务端数据存储
DB_TYPE=mysql
MYSQL_HOST=mysql.example.internal
MYSQL_PORT=3306
MYSQL_DATABASE=ai_token_league_dev
MYSQL_USER=ai_token_league
MYSQL_PASSWORD='change-me'
MYSQL_AUTO_MIGRATE=true
# 多副本场景必填且必须保持同一字符串；与 MYSQL_DATABASE 一一对应。
MYSQL_WRITE_LOCK_NAME=ai-token-league:ai_token_league_dev:write
# 使用 ?? 解析；显式 0 表示 fail-fast，不会被 30 默认值吞掉。
MYSQL_WRITE_LOCK_TIMEOUT_SECONDS=30
# 启用命名锁时，实际 connectionLimit 下限为 2（构造函数自动 floor），不要再设 1。
MYSQL_CONNECTION_LIMIT=8

# 1.3 服务端榜单安全
BOARD_SECURITY_LEVEL=anonymous

# 1.4 服务端更新元数据来源
# 本地部署服务端从自托管 OSS/静态资源读取 updater/installer 元数据。
RELEASE_SOURCE=static
RELEASE_PUBLIC_BASE_URL=https://downloads.example.com/ai-token-league
RELEASE_TAURI_UPDATE_PATH=tauri-releases/tauri-update.json
RELEASE_INSTALLER_PATH=tauri-releases/installer.json
RELEASE_TAURI_UPDATE_URL=
RELEASE_INSTALLER_URL=
RELEASE_MANIFEST_PATH=tauri-releases/latest.json

# ============================================================
# 二、客户端构建与发布配置
# 本地桌面端打包预置、OSS 上传和 Tauri updater 签名。
# ============================================================

# 2.1 客户端打包 / 首次启动预置
PRESET_API_BASE_URL=https://api.example.com
PRESET_LANGUAGE=zh-CN
PRESET_REFRESH_INTERVAL=15
PRESET_LAUNCH_AT_LOGIN=false
PRESET_SHOW_ESTIMATED_COST=true
PRESET_SHOW_RAW_TOKENS=false

# Provider 启用/禁用配置。格式为 PRESET_PROVIDER_<ID>=true/false。
PRESET_PROVIDER_CLAUDE_CODE_LOCAL=true
PRESET_PROVIDER_CODEX_LOCAL=true
PRESET_PROVIDER_CURSOR_DASHBOARD_USAGE=true

# 2.2 自托管发布路径 / OSS 上传
RELEASE_OSS_ENDPOINT=oss-region.example.com
RELEASE_OSS_BUCKET=ai-token-league
RELEASE_OSS_PREFIX=ai-token-league
RELEASE_OSS_ACCESS_KEY_ID=change-me
RELEASE_OSS_ACCESS_KEY_SECRET=change-me

RELEASE_RELEASE_PATH=tauri-releases
RELEASE_REQUIRED_PLATFORMS=darwin-arm64,darwin-x64,win32-x64

# 2.3 Tauri updater 签名
# release.sh 也会在存在 src-tauri/.signing-key 时自动加载。
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
