# ============================================================
# 一、服务端配置
# 覆盖 backend 容器构建、进程运行、存储、鉴权、榜单策略、兼容性、诊断和更新元数据。
# ============================================================

# 1.0 服务端容器构建 / 依赖安装

# Docker 构建 backend 镜像时使用的 Node 基础镜像；非 Docker 场景不读取。
NODE_IMAGE=docker.m.daocloud.io/library/node:22-bookworm-slim

# Docker 构建镜像时注入的 npm registry；用于加速 npm install。
NPM_REGISTRY=https://registry.npmmirror.com

# 1.1 服务端基础运行

# 服务端监听地址；本机开发可用 127.0.0.1，容器或局域网访问通常用 0.0.0.0。
HOST=0.0.0.0

# 服务端监听端口；scripts/start-server.sh 会在端口占用时自动切换到随机端口。
PORT=8787

# 进程默认时区；影响业务日、日志时间和 Node/Rust 侧日期计算。
TZ=Asia/Shanghai

# 可选：覆盖业务日计算时区。为空时依次使用 TZ、Asia/Shanghai。
APP_TIME_ZONE=

# 1.2 服务端数据存储

# 存储后端类型：json 使用本地 JSON 文件；mysql 使用 MySQL。
DB_TYPE=mysql

# DB_TYPE=json 时的 JSON 数据文件路径；DB_TYPE=mysql 时不作为主存储使用。
DB_PATH=data/db.json

# MySQL 连接 URI；配置后优先于 MYSQL_HOST/MYSQL_PORT/MYSQL_USER 等分项。
MYSQL_URL=

# MySQL 主机名或 IP；MYSQL_URL 为空时使用。
MYSQL_HOST=mysql.example.internal

# MySQL 端口；MYSQL_URL 为空时使用。
MYSQL_PORT=3306

# MySQL 数据库名。
MYSQL_DATABASE=ai_token_league

# MySQL 用户名。
MYSQL_USER=root

# MySQL 密码。包含 shell 特殊字符的值必须用单引号包住（例如 >、<、|、&、!、$ 等）。
MYSQL_PASSWORD='change-me'

# MySQL 连接池大小；并发请求较高时可适当调大。
# 注意：MySqlStore 内部始终启用命名锁——即使留空 MYSQL_WRITE_LOCK_NAME，
# 构造函数也会按 MYSQL_DATABASE 自动派生默认锁名（不可在 env 层面关闭）。
# 命名锁需要持有一条连接，紧随其后的写事务又会向同一池申请另一条；只给 1 会让
# 两次 getConnection() 互锁，把"防数据丢失"变成"写请求卡死"。因此构造函数会
# 始终把实际下限 floor 到 2，即便这里写 1 也会被自动提升。
MYSQL_CONNECTION_LIMIT=8

# 是否在服务端启动时自动执行 migrations/001_init_mysql.sql。
MYSQL_AUTO_MIGRATE=true

# MySQL 多实例写入锁；多个 backend 副本连接同一库时必须保持同一个锁名。
# 留空时 MySqlStore 会按 MYSQL_DATABASE 自动派生默认锁名；命名锁始终启用，无法在 env 层面关闭。
MYSQL_WRITE_LOCK_NAME=ai-token-league:ai_token_league:write

# 获取 MySQL 写入锁的最长等待秒数；超时后本次写请求失败并等待客户端重试。
# 使用 ?? 解析：显式 `0` 表示 fail-fast（GET_LOCK(?, 0)，立即失败），不会被默认值 30 吞掉。
MYSQL_WRITE_LOCK_TIMEOUT_SECONDS=30

# 1.3 服务端管理端与榜单安全

# Admin 用户名；留空表示 /admin.html 和 /api/admin/* 不启用 BasicAuth。
ADMIN_USERNAME=

# Admin 密码；仅在 ADMIN_USERNAME 非空时使用。
ADMIN_PASSWORD=

# 榜单安全级别：public 公开真实信息；anonymous API 侧匿名化；authenticated 需要榜单 BasicAuth。
BOARD_SECURITY_LEVEL=public

# 榜单匿名化 salt；anonymous 模式下用于生成每日匿名 ID，留空时读取或生成 salt 文件。
BOARD_ANONYMIZATION_SALT=

# 榜单匿名化 salt 文件路径；文件不存在时自动创建，父目录也会按需创建。
BOARD_ANONYMIZATION_SALT_PATH=data/board-anonymization-salt.key

# 榜单匿名展示名词库路径；JSON 字符串数组文件，为空或非法时回退内置词库。
BOARD_ANONYMIZATION_NAMES_PATH=assets/anonymizer-names.json

# 榜单 BasicAuth 用户名；仅在 BOARD_SECURITY_LEVEL=authenticated 时使用。
PUBLIC_BOARD_AUTH_USERNAME=

# 榜单 BasicAuth 密码；authenticated 模式下为空会导致服务端启动失败。
PUBLIC_BOARD_AUTH_PASSWORD=

# 1.4 服务端客户端兼容性、诊断与价格刷新

# 最新客户端版本；留空时默认使用服务端 package.json version。
LATEST_CLIENT_VERSION=

# 是否阻断低于 LATEST_CLIENT_VERSION 的客户端；snapshot sync 灰度期间通常保持 false。
MIN_CLIENT_ENFORCE=false

# 是否记录每次 usage upload 成功日志；false 时仍会记录 legacyMirrorSync、异常或慢请求。
USAGE_UPLOAD_SUCCESS_LOG=false

# usage upload 慢请求日志阈值，单位毫秒。
SLOW_USAGE_UPLOAD_LOG_MS=1000

# 是否在服务端启动后自动刷新 OpenRouter 模型价格缓存。
OPENROUTER_PRICING_AUTO_REFRESH=true

# OpenRouter 模型列表 API 地址；用于价格刷新。
OPENROUTER_MODELS_URL=https://openrouter.ai/api/v1/models

# OpenRouter 价格刷新请求超时时间，单位毫秒。
OPENROUTER_PRICING_TIMEOUT_MS=10000

# 仅用于测试/调试：强制服务端业务日（YYYY-MM-DD），生产环境应留空。
AI_TOKEN_LEAGUE_BUSINESS_DAY=

# 1.5 服务端更新元数据来源

# 更新来源：github 读取 GitHub Release；static/self-hosted 使用下方静态 URL 或路径。
RELEASE_SOURCE=github

# GitHub Release 仓库，格式 owner/name；RELEASE_SOURCE=github 时使用。
RELEASE_GITHUB_REPOSITORY=SKYhuangjing/ai-token-league

# GitHub API 入口；GitHub Enterprise 或代理环境可覆盖。
RELEASE_GITHUB_API_BASE_URL=https://api.github.com

# 固定读取某个 GitHub tag，例如 v0.6.3；留空表示读取 latest release。
RELEASE_GITHUB_TAG=

# GitHub token；私有仓库或需要更高 API 频率限制时配置。
RELEASE_GITHUB_TOKEN=

# Tauri updater metadata 的相对路径；服务端会用 RELEASE_PUBLIC_BASE_URL 拼出 URL，除非 RELEASE_TAURI_UPDATE_URL 显式配置。
RELEASE_TAURI_UPDATE_PATH=tauri-releases/tauri-update.json

# 下载安装器 metadata 的相对路径；服务端会用 RELEASE_PUBLIC_BASE_URL 拼出 URL，除非 RELEASE_INSTALLER_URL 显式配置。
RELEASE_INSTALLER_PATH=tauri-releases/installer.json

# Tauri updater metadata 的完整 URL；留空时使用 RELEASE_PUBLIC_BASE_URL + RELEASE_TAURI_UPDATE_PATH。
RELEASE_TAURI_UPDATE_URL=

# 下载安装器 metadata 的完整 URL；留空时使用 RELEASE_PUBLIC_BASE_URL + RELEASE_INSTALLER_PATH。
RELEASE_INSTALLER_URL=

# ============================================================
# 二、客户端构建与发布配置
# 覆盖桌面端打包预置、自托管发布路径、OSS 上传和 Tauri updater 签名。
# ============================================================

# 2.1 客户端打包 / 首次启动预置

# 桌面端默认连接的服务端 API 地址；写入 assets/preset.json，仅首次启动且无用户配置时生效。
PRESET_API_BASE_URL=

# 桌面端首次启动默认昵称；留空时让用户自行配置或使用应用默认流程。
PRESET_NICKNAME=

# 桌面端默认语言，例如 zh-CN 或 en；留空时使用应用默认语言判断。
PRESET_LANGUAGE=

# 桌面端默认刷新间隔，单位分钟。
PRESET_REFRESH_INTERVAL=15

# 桌面端是否默认开机启动；用户后续可在设置里修改。
PRESET_LAUNCH_AT_LOGIN=false

# 桌面端是否默认展示预估成本；只影响客户端展示，不影响排行榜 token 排名。
PRESET_SHOW_ESTIMATED_COST=false

# 桌面端是否默认展示原始 token 明细。
PRESET_SHOW_RAW_TOKENS=false

# 默认是否启用 Claude Code 本地日志 provider。
PRESET_PROVIDER_CLAUDE_CODE_LOCAL=true

# 默认是否启用 Codex 本地日志 provider。
PRESET_PROVIDER_CODEX_LOCAL=true

# 默认是否启用 Cursor dashboard usage provider。
PRESET_PROVIDER_CURSOR_DASHBOARD_USAGE=true

# 2.2 自托管发布路径 / OSS 上传

# 自托管发布资源的目录前缀；release.sh/publish-release.js 会把 Tauri 资源放到该目录下。
RELEASE_RELEASE_PATH=tauri-releases

# 发布时要求存在的平台列表；自部署只发布部分平台时可缩小，例如 darwin-arm64,darwin-x64,win32-x64。
RELEASE_REQUIRED_PLATFORMS=darwin-arm64,darwin-x64,win32-x64,linux-x64

# OSS endpoint；publish-release.js 上传对象时使用。
RELEASE_OSS_ENDPOINT=

# OSS bucket；publish-release.js 上传对象时使用。
RELEASE_OSS_BUCKET=

# OSS 对象 key 前缀；通常对应产品目录。
RELEASE_OSS_PREFIX=ai-token-league

# 公开下载 base URL；服务端和发布脚本用它拼接 installer/updater/manifest URL。
RELEASE_PUBLIC_BASE_URL=

# 旧版 latest.json manifest 路径；仍用于兼容历史客户端和发布脚本。
RELEASE_MANIFEST_PATH=tauri-releases/latest.json

# OSS access key id；只放在本地 env、测试 env 或 CI secrets，不应进入公开运行环境。
RELEASE_OSS_ACCESS_KEY_ID=change-me

# OSS access key secret；只放在本地 env、测试 env 或 CI secrets，不应进入公开运行环境。
RELEASE_OSS_ACCESS_KEY_SECRET=change-me

# 上传并发数；网络不稳定或 OSS 限流时可调低。
RELEASE_UPLOAD_CONCURRENCY=3

# 单个对象上传失败后的重试次数。
RELEASE_UPLOAD_ATTEMPTS=3

# 上传请求 headers 超时时间，单位毫秒。
RELEASE_UPLOAD_HEADERS_TIMEOUT_MS=1200000

# 上传请求 body 超时时间，单位毫秒。
RELEASE_UPLOAD_BODY_TIMEOUT_MS=1200000

# 2.3 Tauri updater 签名

# Tauri updater 私钥；release.sh 会在存在 src-tauri/.signing-key 时自动加载，也可由 CI 注入。
TAURI_SIGNING_PRIVATE_KEY=

# Tauri updater 私钥密码；私钥无密码时留空。
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
