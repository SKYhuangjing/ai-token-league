NODE_IMAGE=docker.m.daocloud.io/library/node:22-bookworm-slim
NPM_REGISTRY=https://registry.npmmirror.com

HOST=0.0.0.0
PORT=8787
DB_TYPE=mysql
TZ=Asia/Shanghai

MYSQL_HOST=mysql.dev.1datatm.info
MYSQL_PORT=3306
MYSQL_DATABASE=ai_token_league
MYSQL_USER=root
# Single-quote values containing shell metacharacters (>, <, |, &, !, $, etc.)
MYSQL_PASSWORD='change-me'
MYSQL_AUTO_MIGRATE=true

# 0.3 release/update resources.
# Public values may be shared with app-server. Secrets must be set only in env.local/env.test or CI secrets.
RELEASE_OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
RELEASE_OSS_BUCKET=1data-dev
RELEASE_OSS_PREFIX=ai-token-league
RELEASE_PUBLIC_BASE_URL=https://1data-dev.oss-cn-shanghai.aliyuncs.com/ai-token-league
RELEASE_OSS_ACCESS_KEY_ID=change-me
RELEASE_OSS_ACCESS_KEY_SECRET=change-me

# Admin basicAuth. Leave empty to disable (admin routes remain open).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Board (community leaderboard) basicAuth. Independent from admin auth.
# Leave empty to keep the leaderboard public. Set both to protect /, /index.html and /api/board/*.
# To share credentials with admin, explicitly set the same values as ADMIN_USERNAME/ADMIN_PASSWORD.
PUBLIC_BOARD_AUTH_USERNAME=
PUBLIC_BOARD_AUTH_PASSWORD=

# Client version enforcement. When MIN_CLIENT_ENFORCE=true, clients below LATEST_CLIENT_VERSION are blocked (HTTP 426).
# LATEST_CLIENT_VERSION defaults to server package.json version when empty.
LATEST_CLIENT_VERSION=
MIN_CLIENT_ENFORCE=false

# Build-time preset configuration. Injected into desktop app at build time.
# Only affects first launch (when no user config exists). Leave empty to use defaults.
# Copy this file to env.local and customize — npm run preset reads env.local automatically.
PRESET_API_BASE_URL=
PRESET_NICKNAME=
PRESET_LANGUAGE=
PRESET_AUTO_REFRESH=true
PRESET_REFRESH_INTERVAL=15
PRESET_SILENT_UPDATE=auto_download
PRESET_LAUNCH_AT_LOGIN=false
PRESET_SHOW_ESTIMATED_COST=false
PRESET_SHOW_RAW_TOKENS=false

# Provider enabled/disabled. Use PRESET_PROVIDER_<ID>=true/false.
# Available providers: claude_code_local, codex_local, cursor_dashboard_usage
PRESET_PROVIDER_CLAUDE_CODE_LOCAL=true
PRESET_PROVIDER_CODEX_LOCAL=true
PRESET_PROVIDER_CURSOR_DASHBOARD_USAGE=true
