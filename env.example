NODE_IMAGE=docker.m.daocloud.io/library/node:22-bookworm-slim
NPM_REGISTRY=https://registry.npmmirror.com

HOST=0.0.0.0
PORT=8787
DB_TYPE=mysql
DB_PATH=data/db.json
TZ=Asia/Shanghai
# 可选：覆盖业务日计算时区。为空时依次使用 TZ、Asia/Shanghai。
APP_TIME_ZONE=

MYSQL_URL=
MYSQL_HOST=mysql.dev.1datatm.info
MYSQL_PORT=3306
MYSQL_DATABASE=ai_token_league
MYSQL_USER=root
# 包含 shell 特殊字符的值必须用单引号包住（例如 >、<、|、&、!、$ 等）。
MYSQL_PASSWORD='change-me'
MYSQL_CONNECTION_LIMIT=8
MYSQL_AUTO_MIGRATE=true

# 发布/更新资源配置。客户端始终从本服务端读取更新元数据。
# RELEASE_SOURCE=github 表示读取 GitHub Release 资产；RELEASE_SOURCE=static 或 self-hosted 表示使用下方显式 URL。
RELEASE_SOURCE=github
RELEASE_GITHUB_REPOSITORY=SKYhuangjing/ai-token-league
# 可选：覆盖 GitHub Enterprise 或 GitHub API 入口。
RELEASE_GITHUB_API_BASE_URL=https://api.github.com
# 可选：固定到某个 tag，例如 v0.6.3；留空表示使用最新 GitHub Release。
RELEASE_GITHUB_TAG=
# 可选：私有仓库或需要更高 GitHub API 频率限制时配置。
RELEASE_GITHUB_TOKEN=

# 静态或自托管分发配置。
# Tauri 自部署资源默认写入 tauri-releases，避免复用旧 Electron releases 目录。
RELEASE_RELEASE_PATH=tauri-releases
RELEASE_TAURI_UPDATE_PATH=tauri-releases/tauri-update.json
RELEASE_INSTALLER_PATH=tauri-releases/installer.json
RELEASE_TAURI_UPDATE_URL=
RELEASE_INSTALLER_URL=
# 可选：自部署只发布部分平台时配置，例如 darwin-arm64,darwin-x64,win32-x64。
RELEASE_REQUIRED_PLATFORMS=darwin-arm64,darwin-x64,win32-x64,linux-x64

# OSS 发布资源配置。公开读取相关值可进入 app-server 环境。
# 密钥只能放在 env.local/env.test 或 CI secrets 中。
RELEASE_OSS_ENDPOINT=
RELEASE_OSS_BUCKET=
RELEASE_OSS_PREFIX=ai-token-league
RELEASE_PUBLIC_BASE_URL=
RELEASE_MANIFEST_PATH=tauri-releases/latest.json
RELEASE_OSS_ACCESS_KEY_ID=change-me
RELEASE_OSS_ACCESS_KEY_SECRET=change-me
# 可选：scripts/publish-release.js 上传调优参数。
RELEASE_UPLOAD_CONCURRENCY=3
RELEASE_UPLOAD_ATTEMPTS=3
RELEASE_UPLOAD_HEADERS_TIMEOUT_MS=1200000
RELEASE_UPLOAD_BODY_TIMEOUT_MS=1200000

# 可选：Tauri updater 签名配置。release.sh 会在存在 src-tauri/.signing-key 时自动加载。
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Admin BasicAuth。留空表示关闭鉴权（admin 路由保持开放）。
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 榜单安全级别：public（默认）、anonymous（公开但 API 侧匿名化）、authenticated（BasicAuth）。
# anonymous 模式会隐藏真实 participantId/nickname/workdir；authenticated 模式需要配置下方榜单凭据。
BOARD_SECURITY_LEVEL=public

# 榜单匿名化 salt。可选；留空时服务端从 BOARD_ANONYMIZATION_SALT_PATH 读取或生成。
BOARD_ANONYMIZATION_SALT=

# 榜单匿名化 salt 文件路径。文件不存在时自动创建，父目录也会按需创建。
BOARD_ANONYMIZATION_SALT_PATH=data/board-anonymization-salt.key

# 榜单匿名展示名词库。JSON 字符串数组文件；默认 assets/anonymizer-names.json，为空或非法时回退内置词库。
BOARD_ANONYMIZATION_NAMES_PATH=assets/anonymizer-names.json

# 榜单（社区排行榜）BasicAuth。仅在 BOARD_SECURITY_LEVEL=authenticated 时使用。
# 当 BOARD_SECURITY_LEVEL=authenticated 且凭据为空时，服务端会启动失败。
PUBLIC_BOARD_AUTH_USERNAME=
PUBLIC_BOARD_AUTH_PASSWORD=

# 客户端版本强制升级。MIN_CLIENT_ENFORCE=true 时，低于 LATEST_CLIENT_VERSION 的客户端会被阻断（HTTP 426）。
# LATEST_CLIENT_VERSION 留空时默认使用服务端 package.json 版本。
# snapshot sync 灰度期间保持 MIN_CLIENT_ENFORCE=false，直到活跃客户端都支持 protocol v2。
LATEST_CLIENT_VERSION=
MIN_CLIENT_ENFORCE=false

# 可选：后端诊断日志与价格刷新控制。
USAGE_UPLOAD_SUCCESS_LOG=false
SLOW_USAGE_UPLOAD_LOG_MS=1000
OPENROUTER_PRICING_AUTO_REFRESH=true
OPENROUTER_MODELS_URL=https://openrouter.ai/api/v1/models
OPENROUTER_PRICING_TIMEOUT_MS=10000

# 仅用于测试/调试：强制服务端业务日（YYYY-MM-DD）。
AI_TOKEN_LEAGUE_BUSINESS_DAY=

# 构建期预置配置。打包时注入桌面端。
# 仅影响首次启动（用户配置不存在时）。留空表示使用默认值。
# 复制本文件为 env.local 后自定义；npm run preset 会自动读取 env.local。
PRESET_API_BASE_URL=
PRESET_NICKNAME=
PRESET_LANGUAGE=
PRESET_REFRESH_INTERVAL=15
PRESET_LAUNCH_AT_LOGIN=false
PRESET_SHOW_ESTIMATED_COST=false
PRESET_SHOW_RAW_TOKENS=false

# Provider 启用/禁用配置。格式为 PRESET_PROVIDER_<ID>=true/false。
# 可用 provider：claude_code_local、codex_local、cursor_dashboard_usage
PRESET_PROVIDER_CLAUDE_CODE_LOCAL=true
PRESET_PROVIDER_CODEX_LOCAL=true
PRESET_PROVIDER_CURSOR_DASHBOARD_USAGE=true
