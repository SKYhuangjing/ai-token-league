{
  "name": "ai-token-league",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "main": "src/desktop/main.cjs",
  "scripts": {
    "start": "node src/backend/server.js",
    "desktop": "electron .",
    "desktop:smoke": "electron . --desktop-smoke",
    "collector": "node src/collector/cli.js",
    "collector:init": "node src/collector/cli.js init",
    "collector:scan": "node src/collector/cli.js scan",
    "collector:sync": "node src/collector/cli.js sync",
    "test": "node tests/run-tests.js",
    "smoke": "node tests/run-tests.js && node src/backend/server.js --smoke",
    "icons": "node scripts/generate-icons.js",
    "preset": "node scripts/build-preset.js",
    "package:mac": "npm run package:mac:arm64",
    "package:mac:arm64": "electron-packager . \"AI Token League\" --platform=darwin --arch=arm64 --out=dist --overwrite --icon=assets/app-icon.icns --ignore='^/(dist|dist-installer|\\.tmp[^/]*|data|doc|tests|samples|scripts|migrations|src/backend|src/web|Dockerfile|docker-compose.*|AGENTS\\.md|env\\..*|.*\\.pid|.*\\.log)($|/)'",
    "package:mac:intel": "electron-packager . \"AI Token League\" --platform=darwin --arch=x64 --out=dist --overwrite --icon=assets/app-icon.icns --ignore='^/(dist|dist-installer|\\.tmp[^/]*|data|doc|tests|samples|scripts|migrations|src/backend|src/web|Dockerfile|docker-compose.*|AGENTS\\.md|env\\..*|.*\\.pid|.*\\.log)($|/)'",
    "package:mac:all": "npm run package:mac:arm64 && npm run package:mac:intel",
    "package:installer:mac:arm64": "electron-builder --mac dmg --arm64",
    "package:installer:mac:intel": "electron-builder --mac dmg --x64",
    "package:installer:mac:all": "electron-builder --mac dmg --arm64 --x64",
    "package:installer:win": "electron-builder --win nsis --x64",
    "package:installer:all": "electron-builder --mac dmg --arm64 --x64 --win nsis --x64",
    "package:win": "electron-packager . \"AI Token League\" --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/app-icon.ico --ignore='^/(dist|dist-installer|\\.tmp[^/]*|data|doc|tests|samples|scripts|migrations|src/backend|src/web|Dockerfile|docker-compose.*|AGENTS\\.md|env\\..*|.*\\.pid|.*\\.log)($|/)'",
    "package:all": "npm run package:mac:all && npm run package:win && node scripts/zip-dist.js",
    "release:build": "rm -rf dist dist-installer && npm run preset && npm run package:all && npm run package:installer:all",
    "release:dry-run": "node scripts/publish-release.js --dry-run",
    "release:upload": "node scripts/publish-release.js",
    "release:publish": "npm run release:build && npm run release:upload",
    "bump": "node scripts/bump-version.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "mysql2": "^3.22.3",
    "sql.js": "^1.13.0"
  }
}
