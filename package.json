{
  "name": "ai-token-league",
  "version": "0.7.11",
  "productBaseline": "0.7",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/backend/server.js",
    "desktop": "npx tauri dev",
    "tauri": "tauri",
    "tauri:dev": "npx tauri dev",
    "tauri:build": "npx tauri build",
    "collector": "cargo run -p atl-collector --",
    "collector:init": "cargo run -p atl-collector -- init",
    "collector:scan": "cargo run -p atl-collector -- scan",
    "collector:sync": "cargo run -p atl-collector -- sync",
    "test": "node tests/run-tests.js",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "test:ui:coverage": "vitest run --coverage",
    "test:ui:bench": "vitest bench",
    "test:e2e": "playwright test --config=playwright.mock.config.js",
    "test:e2e:mock": "playwright test --config=playwright.mock.config.js",
    "test:e2e:mock:headed": "playwright test --config=playwright.mock.config.js --headed",
    "test:e2e:tauri": "playwright test",
    "smoke": "node tests/run-tests.js && node src/backend/server.js --smoke",
    "verify:ccusage": "node scripts/verify-ccusage.mjs",
    "icons": "node scripts/generate-icons.js && node scripts/generate-tray-icons.js",
    "icons:tray": "node scripts/generate-tray-icons.js",
    "preset": "node scripts/build-preset.js",
    "release:dry-run": "node scripts/publish-release.js --dry-run --full",
    "release:upload": "node scripts/publish-release.js --full",
    "release:check": "node scripts/check-release-version.js",
    "release": "bash scripts/release.sh",
    "bump": "node scripts/bump-version.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.11.1",
    "@vitest/coverage-v8": "^4.1.7",
    "c8": "^11.0.0",
    "jsdom": "^29.1.1",
    "lucide-static": "^1.14.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "mysql2": "^3.22.3",
    "sql.js": "^1.13.0",
    "undici": "^7.25.0"
  }
}
